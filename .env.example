# Backend API URL (default: http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# Default model used for mobile chat conversations (default: openrouter/free)
VITE_DEFAULT_MODEL=openrouter/free

# Comma-separated list of selectable AI models
VITE_MODELS=openrouter/free

# Public web app origin for share links; required in native Android builds.
# Set this to your deployed web frontend, e.g. https://chat.example.com
VITE_SHARE_URL=
